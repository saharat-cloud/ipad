{
    "builds": [
        {
            "src": "api/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "index.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "assets/**",
            "use": "@vercel/static"
        },
        {
            "src": "uploads/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "/uploads/$1"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ],
    "env": {
        "VERCEL": "1"
    },
    "regions": [
        "sin1"
    ]
}
